/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/chunks/*
!/storage/app/chunks/.gitignore

# Bootstrap cache (artisan package:discover regenerates)
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore