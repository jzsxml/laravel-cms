@extends('admin.layouts.app')

@section('title', $title)

@section('content')
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <a href="{{ url(config('cms.admin_path').'/'.$urlPrefix) }}" class="btn btn-sm btn-secondary mb-3">返回列表</a>
        <div class="table-responsive">
            <table class="table table-bordered table-striped mb-0">
                <thead><tr>{{ list_headers }}</tr></thead>
                <tbody id="tbody"></tbody>
            </table>
        </div>
        <ul class="pagination pagination-sm mt-3" id="pager"></ul>
    </div>
</div>
@endsection

@push('scripts')
<script>
(() => {
    const base = @json(url(config('cms.admin_path').'/'.$urlPrefix));
    const tbody = document.getElementById('tbody');
    const pager = document.getElementById('pager');
    let page = 1;
    const limit = 10;

    function rowHtml(row) {
        return `<tr>{{ list_row_cells }}</tr>`;
    }

    function bindActions() {
        tbody.querySelectorAll('[data-restore]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const body = new URLSearchParams({
                    ids: btn.getAttribute('data-restore'),
                    _token: document.querySelector('meta[name=csrf-token]').content,
                });
                const res = await fetch(`${base}/restore`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                    body,
                });
                const data = await res.json();
                alert(data.msg || '完成');
                if (data.code === 1) load();
            });
        });
    }

    async function load() {
        const res = await fetch(`${base}/recyclebin?limit=${limit}&page=${page}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        });
        const data = await res.json();
        tbody.innerHTML = (data.rows || []).map(rowHtml).join('');
        bindActions();
        const pages = Math.max(1, Math.ceil((data.total || 0) / limit));
        pager.innerHTML = '';
        for (let p = 1; p <= pages; p++) {
            const li = document.createElement('li');
            li.className = 'page-item' + (p === page ? ' active' : '');
            li.innerHTML = `<a class="page-link" href="#">${p}</a>`;
            li.addEventListener('click', (e) => { e.preventDefault(); page = p; load(); });
            pager.appendChild(li);
        }
    }
    load();
})();
</script>
@endpush